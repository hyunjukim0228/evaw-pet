# 이 파일을 복사해 .env.local로 만들고 실제 값을 채워 넣으세요 (.env.local은 git에 올라가지 않습니다).
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인 (anon / public key — service_role 키 절대 아님).
NEXT_PUBLIC_SUPABASE_URL=https://cabdouqmzzarroblzepl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel에 배포할 때는 Vercel 대시보드 > Project Settings > Environment Variables 에도
# 위 두 값을 동일하게 등록해야 실제 배포본에서도 상담폼이 동작합니다.
